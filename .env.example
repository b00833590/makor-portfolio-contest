# Local dev: matches docker-compose.yml. In prod, point to Supabase/Neon.
DATABASE_URL="postgresql://makor:makor@localhost:5432/portfolio_contest?schema=public"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Restrict to the Makor Workspace domain via AUTH_GOOGLE_HD below.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Restricts sign-in to a single Google Workspace domain (e.g. makorgroup.com). Leave empty to allow any Google account.
AUTH_GOOGLE_HD=""

# Comma-separated list of emails granted the admin role on first sign-in.
ADMIN_EMAILS=""

# Market data providers (see src/lib/prices/providers for how to plug these in)
# Without this, stock/ETF prices fall back to the mock provider — CoinGecko (crypto) needs no key.
TWELVE_DATA_API_KEY=""

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when calling
# /api/cron/ingest-prices (see vercel.json). Leave empty to allow unauthenticated
# calls (fine for local dev only).
CRON_SECRET=""
