# Local dev: matches docker-compose.yml. In prod, point to Neon (see docs/DEPLOIEMENT.md).
DATABASE_URL="postgresql://makor:makor@localhost:5432/portfolio_contest?schema=public"

# Market data providers (see src/lib/prices/providers for how to plug these in).
# Used both for stock price ingestion and for the ticker autocomplete search
# (src/app/api/assets/search). Without it, stock search & prices fall back
# to the mock provider. Crypto prices come from Binance (no key ever needed);
# CoinGecko (no key either) is only used for crypto ticker search.
TWELVE_DATA_API_KEY=""

# Shared secret sent as "Authorization: Bearer <value>" when calling
# /api/cron/ingest-prices — both by Vercel Cron (see vercel.json, daily
# fallback) and by the GitHub Actions workflow that calls it every 5 minutes
# (.github/workflows/ingest-prices.yml, set as the repo's CRON_SECRET
# secret — must match this value exactly). Leave empty to allow
# unauthenticated calls (fine for local dev only).
CRON_SECRET=""
