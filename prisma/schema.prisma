generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) — standard adapter models, do not rename fields/relations.
// https://authjs.dev/reference/adapter/prisma
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain model — see docs/CONCEPTION.md section 4
// ---------------------------------------------------------------------------

enum UserRole {
  PARTICIPANT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(PARTICIPANT)
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id])

  portfolios  Portfolio[]
  changeUsage ChangeUsage[]
  badges      UserBadge[]
  auditLogs   AuditLog[]
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// Une saison du concours. Les règles sont versionnées ici pour ne jamais
/// affecter l'historique des saisons précédentes (cf. section 6 de CONCEPTION.md).
model Promotion {
  id             String          @id @default(cuid())
  name           String
  status         PromotionStatus @default(DRAFT)
  startDate      DateTime
  endDate        DateTime
  initialCapital Decimal         @db.Decimal(18, 2)
  /// PromotionRules: { minPositionSize, maxPositionSize, maxPositions, maxCryptoAllocationPct,
  ///                    changeSessionsPerWeek, maxChangesPerSession, freezeHoursBeforeEnd }
  rules          Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  users          User[]
  portfolios     Portfolio[]
  changeSessions ChangeSession[]
  userBadges     UserBadge[]
}

enum AssetType {
  STOCK
  ETF
  CRYPTO
}

model Asset {
  id        String    @id @default(cuid())
  symbol    String    @unique
  name      String
  type      AssetType
  sector    String?
  currency  String    @default("EUR")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  prices       Price[]
  positions    Position[]
  transactions Transaction[]
}

model Price {
  id        String   @id @default(cuid())
  assetId   String
  timestamp DateTime
  price     Decimal  @db.Decimal(18, 6)
  source    String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, timestamp])
}

model Portfolio {
  id          String   @id @default(cuid())
  userId      String
  promotionId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  positions    Position[]
  transactions Transaction[]
  snapshots    PerformanceSnapshot[]

  @@unique([userId, promotionId])
}

model Position {
  id            String    @id @default(cuid())
  portfolioId   String
  assetId       String
  quantity      Decimal   @db.Decimal(18, 6)
  avgEntryPrice Decimal   @db.Decimal(18, 6)
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@index([portfolioId])
}

enum TransactionType {
  BUY
  SELL_FULL
  SELL_PARTIAL
  INCREASE
  DECREASE
}

model Transaction {
  id              String          @id @default(cuid())
  portfolioId     String
  assetId         String
  type            TransactionType
  quantity        Decimal         @db.Decimal(18, 6)
  price           Decimal         @db.Decimal(18, 6)
  amount          Decimal         @db.Decimal(18, 2)
  changeSessionId String?
  createdAt       DateTime        @default(now())

  portfolio     Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset         Asset          @relation(fields: [assetId], references: [id])
  changeSession ChangeSession? @relation(fields: [changeSessionId], references: [id])

  @@index([portfolioId])
}

enum ChangeSessionStatus {
  SCHEDULED
  OPEN
  CLOSED
}

model ChangeSession {
  id                       String              @id @default(cuid())
  promotionId              String
  weekNumber               Int
  opensAt                  DateTime
  closesAt                 DateTime
  status                   ChangeSessionStatus @default(SCHEDULED)
  maxChangesPerParticipant Int

  promotion    Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  usages       ChangeUsage[]
  transactions Transaction[]

  @@index([promotionId])
}

model ChangeUsage {
  id              String @id @default(cuid())
  changeSessionId String
  userId          String
  changesUsed     Int    @default(0)

  changeSession ChangeSession @relation(fields: [changeSessionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([changeSessionId, userId])
}

/// Valeur de portefeuille pré-calculée (job quotidien) pour un classement et
/// des graphiques rapides même avec beaucoup d'historique.
model PerformanceSnapshot {
  id                  String   @id @default(cuid())
  portfolioId         String
  timestamp           DateTime
  totalValue          Decimal  @db.Decimal(18, 2)
  dailyReturnPct      Decimal  @db.Decimal(9, 6)
  cumulativeReturnPct Decimal  @db.Decimal(9, 6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, timestamp])
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String

  userBadges UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String
  promotionId String
  awardedAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId, promotionId])
}

/// Traçabilité de toute action admin — répond directement au problème de
/// dérive non tracée de l'ancien Google Sheet.
model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
}
